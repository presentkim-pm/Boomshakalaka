{
  "name": "presentkim/boomshakalaka",
  "description": "Simple performance test tool for axolotl-pm/PocketMine-MP",
  "type": "project",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\test\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\test\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
